# Copie para .env.local (local). Na Vercel, cadastre em Settings > Environment Variables.

# Login do ADMIN (somente servidor). Use senha longa e única.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Assina os cookies de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=

# Upstash Redis (Vercel > Storage > Marketplace > Upstash Redis). A Vercel injeta KV_REST_API_URL/TOKEN sozinha.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob (Vercel > Storage > Blob). A Vercel injeta esta variável sozinha.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app
# Opcional: só é carregado após consentimento de cookies
NEXT_PUBLIC_GA_ID=
